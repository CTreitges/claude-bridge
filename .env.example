# Vorlage. Die echte .env legt install.sh an (oder du selbst): chmod 600, niemals ins Repo.
#
#   cp .env.example .env && chmod 600 .env
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"   # Token erzeugen
#
# Token, das die App im Authorization-Header mitschickt. Mindestens 32 Zeichen.
# Wer es kennt, kann auf diesem Rechner Claude mit deinen Rechten arbeiten lassen.
BRIDGE_TOKEN=hier-ein-langes-zufaelliges-token

# Optional — Standard, wenn das Widget nichts anderes mitschickt.
# Modell: opus | fable | sonnet | haiku     Effort: low | medium | high | xhigh | max
CLAUDE_DEFAULT_MODEL=opus
CLAUDE_DEFAULT_EFFORT=xhigh
CLAUDE_DEFAULT_ULTRACODE=false

# Optional — Arbeitsverzeichnis der Sessions (Standard: Home). Claude muss ihm schon
# einmal vertraut haben, sonst wartet die Session unsichtbar auf den Vertrauens-Dialog.
CLAUDE_WORKDIR=

# Optional — hoechstens so viele Sessions gleichzeitig; Sessions, die so viele Stunden
# nichts mehr geschrieben haben, schliesst die Bridge vor dem naechsten Start.
CLAUDE_MAX_SESSIONS=5
CLAUDE_IDLE_HOURS=24
